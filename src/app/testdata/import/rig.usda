#usda 1.0
(
    defaultPrim = "Character"
    metersPerUnit = 1
    upAxis = "Y"
)

def SkelRoot "Character"
{
        def Mesh "Body"
        {
            int[] faceVertexCounts = [3, 3, 3, 3]
            int[] faceVertexIndices = [0, 1, 2, 0, 2, 3, 0, 3, 1, 1, 3, 2]
            point3f[] points = [(0, 1, 0), (-1, -1, 1), (1, -1, 1), (0, -1, -1)]
        }

    def Xform "Props"
    {
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Mesh "Hat"
        {
            int[] faceVertexCounts = [3, 3, 3, 3]
            int[] faceVertexIndices = [0, 1, 2, 0, 2, 3, 0, 3, 1, 1, 3, 2]
            point3f[] points = [(0, 1, 0), (-1, -1, 1), (1, -1, 1), (0, -1, -1)]
        }
    }

    def Skeleton "Skel"
    {
        uniform token[] joints = ["root"]
    }

    def SkelAnimation "Wave"
    {
        uniform token[] joints = ["root"]
    }

    def BlendShape "Smile"
    {
        uniform vector3f[] offsets = [(0, 0.1, 0)]
        uniform int[] pointIndices = [0]
    }
}
