package main

import "core:strings"

import sdl "vendor:sdl3"

// Where the app's key codes (keys.odin) meet SDL's: the conversion, the names SDL gives
// keys on this keyboard layout, and a check that every Key constant is SDL's own code.

// The app's key for SDL's key code: the same value.
key_of :: proc(k: sdl.Keycode) -> Key {
	return Key(k)
}

// The name SDL gives `k` ("Page Up", "Keypad 1", "A"), in its own memory.
key_name :: proc(k: Key) -> string {
	return string(sdl.GetKeyName(sdl.Keycode(k)))
}

// The key SDL names `name` (as key_name gives it, any case), or 0 when none is.
key_from_name :: proc(name: string) -> Key {
	return Key(sdl.GetKeyFromName(strings.clone_to_cstring(name, context.temp_allocator)))
}

