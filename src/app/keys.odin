package main

// The app's own key codes, so the commands, the key map and the panels name keys without
// SDL: each is SDL's key code for that key (keys_sdl.odin checks every one at compile
// time), the layout's key with no modifiers, so a key from SDL is turned into one by
// key_of without a table. A key not named here still arrives and compares by its value.
Key :: distinct u32

KEY_UNKNOWN          :: Key(0x00000000)
KEY_BACKSPACE        :: Key(0x00000008)
KEY_TAB              :: Key(0x00000009)
KEY_RETURN           :: Key(0x0000000d)
KEY_ESCAPE           :: Key(0x0000001b)
KEY_SPACE            :: Key(0x00000020)
KEY_PLUS             :: Key(0x0000002b)
KEY_SLASH            :: Key(0x0000002f)
KEY_0                :: Key(0x00000030)
KEY_1                :: Key(0x00000031)
KEY_2                :: Key(0x00000032)
KEY_3                :: Key(0x00000033)
KEY_4                :: Key(0x00000034)
KEY_5                :: Key(0x00000035)
KEY_6                :: Key(0x00000036)
KEY_7                :: Key(0x00000037)
KEY_8                :: Key(0x00000038)
KEY_9                :: Key(0x00000039)
KEY_QUESTION         :: Key(0x0000003f)
KEY_LEFTBRACKET      :: Key(0x0000005b)
KEY_RIGHTBRACKET     :: Key(0x0000005d)
KEY_GRAVE            :: Key(0x00000060)
KEY_A                :: Key(0x00000061)
KEY_B                :: Key(0x00000062)
KEY_C                :: Key(0x00000063)
KEY_D                :: Key(0x00000064)
KEY_E                :: Key(0x00000065)
KEY_F                :: Key(0x00000066)
KEY_G                :: Key(0x00000067)
KEY_H                :: Key(0x00000068)
KEY_I                :: Key(0x00000069)
KEY_J                :: Key(0x0000006a)
KEY_K                :: Key(0x0000006b)
KEY_L                :: Key(0x0000006c)
KEY_M                :: Key(0x0000006d)
KEY_N                :: Key(0x0000006e)
KEY_O                :: Key(0x0000006f)
KEY_P                :: Key(0x00000070)
KEY_Q                :: Key(0x00000071)
KEY_R                :: Key(0x00000072)
KEY_S                :: Key(0x00000073)
KEY_T                :: Key(0x00000074)
KEY_U                :: Key(0x00000075)
KEY_V                :: Key(0x00000076)
KEY_W                :: Key(0x00000077)
KEY_X                :: Key(0x00000078)
KEY_Y                :: Key(0x00000079)
KEY_Z                :: Key(0x0000007a)
KEY_DELETE           :: Key(0x0000007f)
KEY_CAPSLOCK         :: Key(0x40000039)
KEY_F1               :: Key(0x4000003a)
KEY_F2               :: Key(0x4000003b)
KEY_F3               :: Key(0x4000003c)
KEY_F4               :: Key(0x4000003d)
KEY_F5               :: Key(0x4000003e)
KEY_F6               :: Key(0x4000003f)
KEY_F7               :: Key(0x40000040)
KEY_F8               :: Key(0x40000041)
KEY_F9               :: Key(0x40000042)
KEY_F10              :: Key(0x40000043)
KEY_F11              :: Key(0x40000044)
KEY_F12              :: Key(0x40000045)
KEY_SCROLLLOCK       :: Key(0x40000047)
KEY_INSERT           :: Key(0x40000049)
KEY_HOME             :: Key(0x4000004a)
KEY_PAGEUP           :: Key(0x4000004b)
KEY_END              :: Key(0x4000004d)
KEY_PAGEDOWN         :: Key(0x4000004e)
KEY_RIGHT            :: Key(0x4000004f)
KEY_LEFT             :: Key(0x40000050)
KEY_DOWN             :: Key(0x40000051)
KEY_UP               :: Key(0x40000052)
KEY_NUMLOCKCLEAR     :: Key(0x40000053)
KEY_KP_ENTER         :: Key(0x40000058)
