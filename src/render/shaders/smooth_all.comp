#version 450

// One step of whole-mesh smoothing (sculpt.smooth_all_cpu on the GPU): each vertex goes
// to p * (1 - w) + target * w, the target being the mean of its triangles' corners.
// Reads src, writes dst; the host swaps them between steps. `precise` keeps the
// compiler from fusing multiplies and adds, so the arithmetic is the CPU's.
//
// SDL_GPU's SPIR-V layout for compute: set 0 holds the read-only storage buffers, set 1
// the read-write ones, set 2 the uniform buffers.

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer Indices { uint indices[]; };
layout(std430, set = 0, binding = 1) readonly buffer Offsets { uint offsets[]; }; // vertex -> first slot in tris
layout(std430, set = 0, binding = 2) readonly buffer Tris { uint tris[]; };
layout(std430, set = 0, binding = 3) readonly buffer Weights { float weights[]; };
layout(std430, set = 0, binding = 4) readonly buffer Src { float src[]; }; // 3 floats a vertex
layout(std430, set = 1, binding = 0) writeonly buffer Dst { float dst[]; };

layout(std140, set = 2, binding = 0) uniform Params {
	uint vertex_count;
	uint groups_x; // the dispatch's width, since a large mesh needs a second dimension
};

vec3 at(uint v) {
	return vec3(src[3 * v], src[3 * v + 1], src[3 * v + 2]);
}

void main() {
	uint v = (gl_WorkGroupID.y * groups_x + gl_WorkGroupID.x) * 256 + gl_LocalInvocationID.x;
	if (v >= vertex_count) return;
	precise vec3 p = at(v);
	float w = weights[v];
	uint first = offsets[v];
	uint last = offsets[v + 1];
	if (w > 0.0 && last > first) {
		precise vec3 sum = vec3(0.0);
		for (uint k = first; k < last; k++) {
			uint f = tris[k];
			sum += at(indices[3 * f]) + at(indices[3 * f + 1]) + at(indices[3 * f + 2]);
		}
		precise vec3 target = sum / float(3 * (last - first));
		p = p * (1.0 - w) + target * w;
	}
	dst[3 * v] = p.x;
	dst[3 * v + 1] = p.y;
	dst[3 * v + 2] = p.z;
}
