<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The iPad app's Info.plist, copied into Sculpt.app by `./build.sh ios`, which also sets
	MinimumOSVersion from IOS_MIN and CFBundleVersion from the build number. The bundle ID is
	Android's applicationId, and never changes: AltStore's free signing counts each new one.
	UILaunchScreen lets the app run at the screen's full size without a storyboard; leaving
	UIRequiresFullScreen out keeps Split View and Stage Manager (the sm-store rules).
	UIFileSharingEnabled shows the app's Documents folder in the Files app (On My iPad >
	Sculpt), where the save dialog starts (ios/sculpt_ios.m).
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.cuzmix.sculpt</string>
	<key>CFBundleExecutable</key>
	<string>Sculpt</string>
	<key>CFBundleName</key>
	<string>Sculpt</string>
	<key>CFBundleDisplayName</key>
	<string>Sculpt</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>
	<key>MinimumOSVersion</key>
	<string>17.4</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
