# Pinned dependency versions. Change deliberately and re-run scripts/setup_deps.sh.
ODIN_TAG=dev-2026-10
SDL_TAG=release-3.4.18
LUAU_TAG=0.744
# ufbx, the FBX reader Import uses (scripts/build_ufbx.py): one C file, MIT or public domain.
UFBX_TAG=v0.23.1
# AutoRemesher's core, the Quad Remesh engine (scripts/build_autoremesher.py): C++ and MIT, with its
# bundled Eigen (MPL 2.0, EIGEN_MPL2_ONLY), isotropicremesher and meshoptimizer (MIT). No release tag
# points at this commit, so it is pinned by hash.
AUTOREMESHER_COMMIT=4a49f82f720f647691c09a7d8a16fa63be208aad
# The Slang shader compiler, from the LunarG Vulkan SDK of this version (shader authors only:
# the compiled .spv files are committed). VULKAN_SDK_SHA256 is the Linux tarball's hash.
VULKAN_SDK=1.4.363.0
VULKAN_SDK_SHA256=197962f5cbf80baf2775a03336a01cee7c8745686c65aaa70d3f751ade4d7e43
# SDL_shadercross, which turns each committed .spv into the Metal source (.msl) the iPad
# build embeds (scripts/build_shadercross.py, scripts/shaders_msl.py; shader authors only:
# the .msl files are committed). It has no releases, so this is a commit on its main
# branch; SPIRV-Cross is the commit its external/SPIRV-Cross submodule names there.
SHADERCROSS_COMMIT=1ff05bec573988a98ef9e0260b4da44f512b8367
SPIRV_CROSS_COMMIT=1a6169566c73d3da552748fc372fe2bbb856e46e
