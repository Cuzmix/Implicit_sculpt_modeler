+// The eigenvalues of a symmetric 3×3 matrix, largest first, and their unit eigenvectors,
+// by cyclic Jacobi rotations (a few sweeps reach float precision for 3×3).
+@(private)
+symmetric_eigen3 :: proc(a: matrix[3, 3]f32) -> (values: [3]f32, vectors: [3]Vec3) {
+	s := a
+	v := matrix[3, 3]f32{1, 0, 0, 0, 1, 0, 0, 0, 1}
+	for _ in 0 ..< 12 {
+		off := s[0, 1] * s[0, 1] + s[0, 2] * s[0, 2] + s[1, 2] * s[1, 2]
+		if off < 1e-20 do break
+		for pq in ([3][2]int{{0, 1}, {0, 2}, {1, 2}}) {
+			p, q := pq[0], pq[1]
+			if abs(s[p, q]) < 1e-30 do continue
+			theta := (s[q, q] - s[p, p]) / (2 * s[p, q])
+			t := math.sign(theta) / (abs(theta) + math.sqrt(theta * theta + 1)) if theta != 0 else 1
+			c := 1 / math.sqrt(t * t + 1)
+			sn := t * c
+			rot := matrix[3, 3]f32{1, 0, 0, 0, 1, 0, 0, 0, 1}
