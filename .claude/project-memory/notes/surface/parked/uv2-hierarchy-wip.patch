+// Islands of at least this many triangles are solved through a simplified copy of about
+// HIERARCHY_COARSE triangles: the direct factor's work grows as n^1.5, a conjugate
+// gradient step's only as n, and the copy's answer leaves the steps only local error to
+// remove, which they remove fast.
+@(private)
+HIERARCHY_TRIANGLES :: 60_000
+@(private)
+HIERARCHY_COARSE :: 20_000
+// Steps of conjugate gradients at most, and the share of the right side's size they have
+// to bring the residual under.
+@(private)
+CG_STEPS :: 400
+@(private)
+CG_TOLERANCE :: 1e-6
+// The steps' loops run in chunks of this many triangles or wedges (parallel_ranges cuts
+// at its multiples), and their sums are added chunk by chunk in order.
+@(private)
+CHUNK :: 4096
+
+// Hierarchical LSCM: solves the island simplified (geom.simplify, which keeps the border
+// and the held wedges where they are), places the wedges the copy dropped by unfolding
+// their triangles from the ones it kept, and refines the whole by conjugate gradients.
+// False, with `flat` to be solved again, when the copy loses a held wedge or the steps
+// do not converge.
+@(private)
+conformal_hierarchy :: proc(place: []geom.Vec3, corners: []u32, coef: [][3][2]f64, fixed: []bool, flat: [][2]f64, pool: ^jobs.Pool, a: runtime.Allocator) -> bool {
+	wedges := len(fixed)
+	weight := make([]f32, wedges, a)
+	defer delete(weight, a)
+	for &w, i in weight do w = 1e6 if fixed[i] else 1
+	coarse_corners := make([dynamic]u32, a)
+	defer delete(coarse_corners)
+	_ = geom.simplify(place, corners, HIERARCHY_COARSE, &coarse_corners, a, strict = true, guide = {weight = weight})
+	// The copy's own numbering of the wedges it kept, in their order.
+	local := make([]i32, wedges, a)
+	defer delete(local, a)
+	for &l in local do l = -1
+	for c in coarse_corners do local[c] = 0
+	kept := 0
+	for &l in local do if l == 0 {
+		l = i32(kept)
+		kept += 1
+	}
+	for f, w in fixed do if f && local[w] < 0 do return false
+	small_place := make([]geom.Vec3, kept, a)
+	defer delete(small_place, a)
+	small_fixed := make([]bool, kept, a)
+	defer delete(small_fixed, a)
+	small_flat := make([][2]f64, kept, a)
+	defer delete(small_flat, a)
+	for l, w in local do if l >= 0 {
+		small_place[l], small_fixed[l], small_flat[l] = place[w], fixed[w], flat[w]
+	}
+	for &c in coarse_corners do c = u32(local[c])
+	small_coef, _, sound := conformal_coefficients(small_place, coarse_corners[:], a)
+	defer delete(small_coef, a)
+	if !sound || !conformal_direct(small_place, coarse_corners[:], small_coef, small_fixed, small_flat, pool, a) do return false
+
+	// The dropped wedges, placed a ring at a time, each at the mean of its placed
+	// neighbours: a start the steps then make conformal, and one that never extrapolates.
+	known := make([]bool, wedges, a)
+	defer delete(known, a)
+	for l, w in local do if l >= 0 {
+		flat[w] = small_flat[l]
+		known[w] = true
+	}
+	sum := make([][2]f64, wedges, a)
+	defer delete(sum, a)
+	count := make([]u32, wedges, a)
+	defer delete(count, a)
+	n := len(corners) / 3
+	for {
+		for t in 0 ..< n {
+			w := corners[3 * t:][:3]
+			for k in 0 ..< 3 do if !known[w[k]] do for o in 1 ..< 3 do if known[w[(k + o) % 3]] {
+				sum[w[k]] += flat[w[(k + o) % 3]]
+				count[w[k]] += 1
+			}
+		}
+		placed := false
+		for c, x in count do if c > 0 {
+			flat[x] = sum[x] / f64(c)
+			known[x] = true
+			sum[x], count[x] = {}, 0
+			placed = true
+		}
+		if !placed do break
+	}
+	for k in known do if !k do return false
+	return conformal_iterate(corners, coef, fixed, flat, pool, a)
+}
+
+// Conjugate gradients on LSCM's normal equations from the coordinates in `flat`,
+// preconditioned by their diagonal; true when the residual fell under CG_TOLERANCE of
+// the right side's within CG_STEPS. Each step's sums run over fixed chunks added in
+// order, so the result does not depend on the pool.
+@(private)
+conformal_iterate :: proc(corners: []u32, coef: [][3][2]f64, fixed: []bool, flat: [][2]f64, pool: ^jobs.Pool, a: runtime.Allocator) -> bool {
+	wedges := len(fixed)
+	n := len(corners) / 3
+	// Each wedge's corners, so a wedge gathers its sums in the same order on any pool.
+	first := make([]u32, wedges + 1, a)
+	defer delete(first, a)
+	for c in corners do first[c + 1] += 1
+	for w in 0 ..< wedges do first[w + 1] += first[w]
+	of := make([]u32, len(corners), a)
+	defer delete(of, a)
+	fill := make([]u32, wedges, a)
+	defer delete(fill, a)
+	copy(fill, first[:wedges])
+	for c, x in corners {
+		of[fill[c]] = u32(x)
+		fill[c] += 1
+	}
+	diagonal := make([]f64, wedges, a)
+	defer delete(diagonal, a)
+	for w in 0 ..< wedges do for x in first[w] ..< first[w + 1] do diagonal[w] += linalg.length2(coef[of[x] / 3][of[x] % 3])
+	rows := make([][2]f64, n, a)
+	defer delete(rows, a)
+	r := make([][2]f64, wedges, a)
+	defer delete(r, a)
+	z := make([][2]f64, wedges, a)
+	defer delete(z, a)
+	p := make([][2]f64, wedges, a)
+	defer delete(p, a)
+	q := make([][2]f64, wedges, a)
+	defer delete(q, a)
+	partial := make([]f64, (wedges + CHUNK - 1) / CHUNK, a)
+	defer delete(partial, a)
+
+	Pass :: struct {
+		corners:         []u32,
+		coef:            [][3][2]f64,
+		fixed:           []bool,
+		first, of:       []u32,
+		rows:            [][2]f64,
+		x, out:          [][2]f64,
+		negate:          bool,
+		a, b:            [][2]f64,
+		partial:         []f64,
+	}
+	// out = AᵀA·x over the free wedges (x is zero on the held ones unless `negate`, when
+	// out = -Aᵀ(A·x), the residual for the right side zero).
+	apply :: proc(ps: ^Pass, pool: ^jobs.Pool) {
+		jobs.parallel_ranges(pool, len(ps.rows), ps, proc(data: rawptr, lo, hi: int) {
+			ps := cast(^Pass)data
+			for t in lo ..< hi {
+				re, im: f64
+				for j in 0 ..< 3 {
+					c := ps.coef[t][j]
+					x := ps.x[ps.corners[3 * t + j]]
+					re += c.x * x.x - c.y * x.y
+					im += c.y * x.x + c.x * x.y
+				}
+				ps.rows[t] = {re, im}
+			}
+		}, CHUNK)
+		jobs.parallel_ranges(pool, len(ps.fixed), ps, proc(data: rawptr, lo, hi: int) {
+			ps := cast(^Pass)data
+			for w in lo ..< hi {
+				if ps.fixed[w] {
+					ps.out[w] = {}
+					continue
+				}
+				g: [2]f64
+				for x in ps.first[w] ..< ps.first[w + 1] {
+					c := ps.coef[ps.of[x] / 3][ps.of[x] % 3]
+					row := ps.rows[ps.of[x] / 3]
+					g += {c.x * row.x + c.y * row.y, -c.y * row.x + c.x * row.y}
+				}
+				ps.out[w] = -g if ps.negate else g
+			}
+		}, CHUNK)
+	}
+	// Σ a·b over the wedges, by chunks added in order.
+	dot :: proc(ps: ^Pass, a, b: [][2]f64, pool: ^jobs.Pool) -> f64 {
+		ps.a, ps.b = a, b
+		jobs.parallel_ranges(pool, len(a), ps, proc(data: rawptr, lo, hi: int) {
+			ps := cast(^Pass)data
+			s: f64
+			for w in lo ..< hi do s += linalg.dot(ps.a[w], ps.b[w])
+			ps.partial[lo / CHUNK] = s
+		}, CHUNK)
+		total: f64
+		for s in ps.partial do total += s
+		return total
+	}
+	ps := Pass{corners = corners, coef = coef, fixed = fixed, first = first, of = of, rows = rows, partial = partial}
+	// The yardstick: the residual with every free wedge at the origin, the right side's.
+	for w in 0 ..< wedges do p[w] = flat[w] if fixed[w] else {}
+	ps.x, ps.out, ps.negate = p, r, true
+	apply(&ps, pool)
+	for w in 0 ..< wedges do z[w] = r[w] / diagonal[w] if !fixed[w] && diagonal[w] > 0 else {}
+	start := dot(&ps, r, z, pool)
+	ps.x, ps.out, ps.negate = flat, r, true
+	apply(&ps, pool)
+	for w in 0 ..< wedges do z[w] = r[w] / diagonal[w] if !fixed[w] && diagonal[w] > 0 else {}
+	copy(p, z)
+	rz := dot(&ps, r, z, pool)
+	if rz <= CG_TOLERANCE * CG_TOLERANCE * start do return true
+	for _ in 0 ..< CG_STEPS {
+		ps.x, ps.out, ps.negate = p, q, false
+		apply(&ps, pool)
+		pq := dot(&ps, p, q, pool)
+		if !(pq > 0) do return false
+		alpha := rz / pq
+		for w in 0 ..< wedges {
+			flat[w] += alpha * p[w]
+			r[w] -= alpha * q[w]
+			z[w] = r[w] / diagonal[w] if !fixed[w] && diagonal[w] > 0 else {}
+		}
+		next := dot(&ps, r, z, pool)
+		if next <= CG_TOLERANCE * CG_TOLERANCE * start do return true
+		beta := next / rz
+		rz = next
+		for w in 0 ..< wedges do p[w] = z[w] + beta * p[w]
+	}
+	return false
+}
