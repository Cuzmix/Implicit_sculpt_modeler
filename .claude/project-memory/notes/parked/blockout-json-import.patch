+package geom
+
+import "core:math"
+import "core:strings"
+import "core:testing"
+
+import "../jobs"
+
+@(test)
+blockout_shapes_are_closed_and_hold_their_volume :: proc(t: ^testing.T) {
+	PI :: math.PI
+	Case :: struct {
+		shape:  Shape,
+		volume: f64,
+	}
+	cases := [?]Case {
+		{{kind = .Sphere, center = {0.3, -1, 2}, radius = 1.5}, 4.0 / 3 * PI * 1.5 * 1.5 * 1.5},
+		{{kind = .Ellipsoid, center = {1, 0, 0}, size = {1, 0.5, 2}, rotate = {30, 45, 10}}, 4.0 / 3 * PI * 1 * 0.5 * 2},
+		{{kind = .Capsule, from = {0, 0, 0}, to = {1, 2, -1}, radius = 0.4, radius_to = 0.4}, PI * 0.16 * math.sqrt(f64(6)) + 4.0 / 3 * PI * 0.064},
+		{{kind = .Cylinder, from = {0, 0, 0}, to = {0, 0, 3}, radius = 0.5, radius_to = 0.5}, PI * 0.25 * 3},
+		{{kind = .Cylinder, from = {1, 1, 1}, to = {1, 3, 1}, radius = 0.6, radius_to = 0}, PI * 0.36 * 2 / 3},
+		{{kind = .Cylinder, from = {0, 0, 0}, to = {-2, 0, 0}, radius = 0.2, radius_to = 0.5}, PI * 2 / 3 * (0.04 + 0.1 + 0.25)},
+		{{kind = .Box, center = {0, 1, 0}, size = {1, 2, 3}, rotate = {10, 20, 30}}, 6},
+		{{kind = .Torus, center = {0, 0, 0}, radius = 1, tube = 0.25, rotate = {90, 0, 0}}, 2 * PI * PI * 1 * 0.0625},
+	}
+	for c in cases {
+		m: Mesh
+		defer mesh_destroy(&m)
+		shape_append(&m, c.shape, 0.001)
+		r := mesh_check(m)
+		testing.expectf(t, r.closed && !r.inverted && r.degenerate_triangles == 0 && r.nan_count == 0, "%v: %v", c.shape.kind, r)
+		testing.expectf(t, abs(r.volume / c.volume - 1) < 0.01, "%v: volume %v, expected %v", c.shape.kind, r.volume, c.volume)
+
+		// Its mirror image, clear of it, doubles it and faces out too.
+		mirrored := c.shape
+		mirrored.mirror = true
+		mirrored.center += {10, 0, 0}
+		mirrored.from += {10, 0, 0}
+		mirrored.to += {10, 0, 0}
+		both: Mesh
+		defer mesh_destroy(&both)
+		shape_append(&both, mirrored, 0.001)
+		rb := mesh_check(both)
+		testing.expectf(t, rb.closed && !rb.inverted && abs(rb.volume / r.volume - 2) < 1e-3, "%v mirrored: %v", c.shape.kind, rb)
+	}
+	// A tapered capsule: its volume lies between the cone through the centres with the
+	// end spheres added and that minus the overlaps, so check the sphere-swept shape's
+	// own count instead: closed, outward, and fatter than the bare frustum.
+	m: Mesh
+	defer mesh_destroy(&m)
+	shape_append(&m, {kind = .Capsule, from = {0, 0, 0}, to = {0, 1, 0}, radius = 0.5, radius_to = 0.1}, 0.001)
+	r := mesh_check(m)
+	frustum := PI * 1 / 3 * (0.25 + 0.05 + 0.01)
+	testing.expectf(t, r.closed && !r.inverted && r.volume > frustum, "tapered capsule: %v", r)
+}
+
+@(test)
+blockout_merges_overlapping_shapes_into_one_surface :: proc(t: ^testing.T) {
+	pool: jobs.Pool
+	jobs.pool_init(&pool, 3)
+	defer jobs.pool_destroy(&pool)
+	// Two unit spheres one apart: their union is both less the lens they share,
+	// π (4r + d)(2r − d)² / 12.
+	shapes := [?]Shape{{kind = .Sphere, radius = 1}, {kind = .Sphere, center = {1, 0, 0}, radius = 1}}
+	union_volume := 2 * 4.0 / 3 * math.PI - math.PI * 5 / 12
+	for target in ([?]int{5_000, 40_000}) {
+		out, ok := blockout_mesh(shapes[:], target, &pool)
+		defer mesh_destroy(&out)
+		testing.expect(t, ok)
+		r := mesh_check(out)
+		testing.expectf(t, r.closed && !r.inverted && r.degenerate_triangles == 0, "%d: %v", target, r)
+		testing.expectf(t, abs(r.volume / union_volume - 1) < 0.03, "%d: volume %v, expected %v", target, r.volume, union_volume)
+		testing.expectf(t, len(out.positions) > target * 7 / 10 && len(out.positions) < target * 3 / 2, "%d: %d vertices", target, len(out.positions))
+		testing.expect(t, len(out.normals) == len(out.positions), "the merged surface has normals")
+	}
+	_, none := blockout_mesh(nil, 1000, &pool)
+	testing.expect(t, !none, "no shapes, no mesh")
+}
+
+@(test)
+blockout_parse_reads_every_kind_and_says_what_is_wrong :: proc(t: ^testing.T) {
+	text := `{
+		"name": "test", // JSON5: comments and trailing commas
+		"shapes": [
+			{"type": "sphere", "center": [0, 1, 0], "radius": 0.5, "note": "head"},
+			{"type": "ellipsoid", "center": [0, 0, 0], "radii": [0.6, 0.8, 0.4], "rotate": [0, 0, 10]},
+			{"type": "capsule", "from": [0.3, 0.5, 0], "to": [0.9, 0, 0], "radius": 0.12, "radius_to": 0.08, "mirror": true},
+			{"type": "cylinder", "from": [0, -1, 0], "to": [0, -0.8, 0], "radius": 0.3, "radius_to": 0},
+			{"type": "box", "center": [0, -1, 0], "size": [1, 0.1, 1]},
+			{"type": "torus", "center": [0, 1.4, 0], "radius": 0.3, "tube": 0.05},
+		],
+	}`
+	shapes, err := blockout_parse(transmute([]u8)text)
+	testing.expectf(t, err == "" && len(shapes) == 6, "%q, %d shapes", err, len(shapes))
+	if len(shapes) == 6 {
+		testing.expect(t, shapes[0].kind == .Sphere && shapes[0].center == {0, 1, 0} && shapes[0].radius == 0.5)
+		testing.expect(t, shapes[1].size == {0.6, 0.8, 0.4} && shapes[1].rotate == {0, 0, 10})
+		testing.expect(t, shapes[2].mirror && shapes[2].radius_to == 0.08 && shapes[2].to == {0.9, 0, 0})
+		testing.expect(t, shapes[3].kind == .Cylinder && shapes[3].radius_to == 0)
+		testing.expect(t, shapes[4].size == {1, 0.1, 1} && shapes[4].rotate == {})
+		testing.expect(t, shapes[5].tube == 0.05 && !shapes[5].mirror)
+	}
+	bare, bare_err := blockout_parse(transmute([]u8)string(`[{"type": "capsule", "from": [0,0,0], "to": [0,1,0], "radius": 0.2}]`))
+	testing.expectf(t, bare_err == "" && len(bare) == 1 && bare[0].radius_to == 0.2, "a bare array, radius_to defaulting to radius: %q", bare_err)
+
+	Bad :: struct {
+		text, says: string,
+	}
+	bad := [?]Bad {
+		{`{"shapes": [`, "not valid JSON"},
+		{`{"parts": []}`, `no "shapes"`},
+		{`{"shapes": []}`, "no shapes"},
+		{`[{"type": "sphere", "center": [0,0,0], "radius": 1}, {"type": "cube"}]`, "shape 2 (cube): unknown type"},
+		{`[{"type": "sphere", "center": [0,0,0]}]`, `no "radius"`},
+		{`[{"type": "sphere", "center": [0,0], "radius": 1}]`, `"center" is not three numbers`},
+		{`[{"type": "sphere", "center": [0,0,0], "radius": -1}]`, "not above 0"},
+		{`[{"type": "sphere", "center": [0,0,0], "radius": 1, "mirror": "yes"}]`, `"mirror"`},
+		{`[{"type": "cylinder", "from": [0,0,0], "to": [0,0,0], "radius": 1}]`, "same point"},
+		{`[{"type": "torus", "center": [0,0,0], "radius": 0.1, "tube": 0.2}]`, `"radius" above "tube"`},
+		{`[{"type": "box", "center": [0,0,0], "size": [1,0,1]}]`, "not above 0"},
+		{`[3]`, "shape 1 is not an object"},
+	}
+	for b in bad {
+		_, e := blockout_parse(transmute([]u8)b.text)
+		testing.expectf(t, strings.contains(e, b.says), "%s: said %q, expected %q", b.text, e, b.says)
+	}
+}
