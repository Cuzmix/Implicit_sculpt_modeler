{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git ls-files:*)",
			"Bash(git rev-parse:*)",
			"Bash(git blame:*)",
			"Bash(build.bat:*)",
			"Bash(./build.bat:*)",
			"Bash(cmd //c build.bat:*)",
			"Bash(cmd.exe //d //c build.bat:*)",
			"Bash(./build.sh:*)",
			"Bash(bash build.sh:*)",
			"Bash(python scripts/ppm.py:*)",
			"Bash(python scripts/agents_sync.py:*)",
			"Bash(python scripts/test_agents_sync.py:*)",
			"Bash(python3 scripts/ppm.py:*)",
			"Bash(python3 scripts/agents_sync.py:*)",
			"Bash(python3 scripts/test_agents_sync.py:*)",
			"Bash(deps/odin/odin.exe check:*)",
			"Bash(deps/odin/odin.exe version)",
			"Bash(deps/odin/odin.exe root)",
			"Bash(deps/odin/odin.exe doc:*)",
			"Bash(deps/odin/odin check:*)",
			"Bash(deps/odin/odin version)",
			"Bash(deps/odin/odin root)",
			"Bash(deps/odin/odin doc:*)",
			"Bash(build/sculpt.exe:*)",
			"Bash(./build/sculpt.exe:*)",
			"Bash(build/bench.exe:*)",
			"Bash(./build/bench.exe:*)",
			"Bash(./build/sculpt:*)",
			"Bash(./build/bench:*)",
			"PowerShell(git status:*)",
			"PowerShell(git diff:*)",
			"PowerShell(git log:*)",
			"PowerShell(git show:*)",
			"PowerShell(git ls-files:*)",
			"PowerShell(.\\build.bat:*)",
			"PowerShell(cmd.exe /d /c:*)",
			"PowerShell(python scripts/ppm.py:*)",
			"PowerShell(python scripts/agents_sync.py:*)",
			"PowerShell(python scripts/test_agents_sync.py:*)",
			"PowerShell(.\\deps\\odin\\odin.exe check:*)",
			"PowerShell(.\\deps\\odin\\odin.exe version)",
			"PowerShell(.\\build\\sculpt.exe:*)",
			"PowerShell(.\\build\\bench.exe:*)"
		],
		"deny": [
			"Bash(git reset --hard:*)",
			"Bash(git clean:*)",
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git checkout --:*)",
			"Bash(git branch -D:*)",
			"PowerShell(git reset --hard:*)",
			"PowerShell(git clean:*)",
			"PowerShell(git push --force:*)",
			"PowerShell(git push -f:*)",
			"Edit(.agents/**)",
			"Edit(build/**)",
			"Edit(deps/**)",
			"Edit(**/*.spv)"
		]
	}
}
